---
import { base } from "../lib/paths";

export interface Props {
  light?: boolean;
}
const { light = true } = Astro.props;
---

<a href={base} class="logo" aria-label="HVAC JJSE CORP - Home">
  <svg width="28" height="28" viewBox="0 0 64 64" aria-hidden="true">
    <circle cx="24" cy="32" r="13" fill="#FBC54B"/>
    <g stroke="#86C4E2" stroke-width="4" stroke-linecap="round">
      <line x1="40" y1="16" x2="40" y2="48"/>
      <line x1="26" y1="24" x2="54" y2="40"/>
      <line x1="26" y1="40" x2="54" y2="24"/>
    </g>
  </svg>
  <span class:list={["wordmark", { light }]}>JJSE</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .wordmark {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: 0.02em;
    color: var(--color-text);
  }
  .wordmark.light {
    color: #fff;
  }
</style>
