---
import site from "../data/site.json";
const { eyebrow, title, subtitle, items: services } = site.services;
---

<section id="services" class="section-pad services">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <p class="subtitle">{subtitle}</p>

    <div class="grid">
      {services.map((s) => (
        <div class="card" data-reveal>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--color-ice);
  }

  .subtitle {
    max-width: 480px;
    margin-top: 16px;
    margin-bottom: 56px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .card {
    background: #fff;
    border-radius: 16px;
    padding: 32px 28px;
  }

  .card h3 {
    margin-bottom: 12px;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
